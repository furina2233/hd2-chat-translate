{
  "schema_version": 2,
  "option_id": "hd2chattranslate.target_language",
  "mod_id": "hd2chattranslate",
  "default_index": 1,
  "menu_options": {
    "enabled": {
      "option_id": "hd2chattranslate.enabled",
      "type": "toggle",
      "label": "启用",
      "default": true,
      "description": "无论是否启用，都会监听聊天框。要想完全移除，请在模组管理器中卸载模组。"
    },
    "ignore_self": {
      "option_id": "hd2chattranslate.ignore_self",
      "type": "toggle",
      "label": "不翻译自己说的话",
      "default": true,
      "description": "开启后不翻译识别为自己发送的消息；无法确认发送者时照常翻译。"
    },
    "enemy_slang": {
      "option_id": "hd2chattranslate.enemy_slang",
      "type": "toggle",
      "label": "将敌人翻译为口语",
      "default": true,
      "description": "仅使用AI翻译且目标语言为中文时可用，启用后会将游戏内敌人名字翻译为口语，会增加token消耗。"
    },
    "timeout": {
      "option_id": "hd2chattranslate.timeout",
      "type": "choice",
      "label": "请求超时",
      "default_index": 2,
      "description": "单次翻译请求最长等待时间。",
      "choices": [
        {"label": "10秒", "seconds": 10},
        {"label": "20秒", "seconds": 20},
        {"label": "30秒", "seconds": 30}
      ]
    },
    "interface_type": {
      "option_id": "hd2chattranslate.interface_type",
      "type": "choice",
      "label": "接口类型",
      "default_index": 1,
      "description": "选择翻译服务接口，应用后对后续消息生效。",
      "choices": [
        {"id": "free", "label": "免费版"},
        {"id": "chat_completions", "label": "Chat Completions接口"},
        {"id": "anthropic", "label": "Anthropic接口"},
        {"id": "baidu", "label": "百度翻译"},
        {"id": "youdao", "label": "有道翻译"},
        {"id": "bing_cn", "label": "必应翻译国内版"},
        {"id": "bing_global", "label": "必应翻译国际版"},
        {"id": "google", "label": "谷歌翻译"}
      ]
    }
  },
  "languages": [
    {
      "id": "zh_cn",
      "label": "简体中文",
      "ai_target": "简体中文",
      "google": "zh-CN",
